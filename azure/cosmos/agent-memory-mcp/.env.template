# Agent Memory MCP server environment template.
# Copy to .env and fill in values. Do not commit real secrets.

# ---- Cosmos connection (shared with the SDK) ----
# Cosmos DB account endpoint, for example https://<account>.documents.azure.com:443/
COSMOS_DB_ENDPOINT=
# Optional account key for local development; prefer DefaultAzureCredential or managed identity when unset.
COSMOS_DB_KEY=
# Cosmos database and container names.
COSMOS_DB_DATABASE=ai_memory
COSMOS_DB_MEMORIES_CONTAINER=memories
COSMOS_DB_SUMMARIES_CONTAINER=memories_summaries
COSMOS_DB_TURNS_CONTAINER=memories_turns
COSMOS_DB_COUNTERS_CONTAINER=counter
COSMOS_DB_LEASE_CONTAINER=leases

# ---- Embeddings / LLM (shared with the SDK) ----
# Azure AI Foundry / Azure OpenAI endpoint, for example https://<resource>.openai.azure.com/
AI_FOUNDRY_ENDPOINT=
# Optional API key for local development; prefer DefaultAzureCredential or managed identity when unset.
AI_FOUNDRY_API_KEY=
# Embedding and chat deployments used by the memory processing/search pipeline.
AI_FOUNDRY_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
# Optional embedding dimensionality override; leave blank to use the deployment default.
AI_FOUNDRY_EMBEDDING_DIMENSIONS=
AI_FOUNDRY_CHAT_DEPLOYMENT_NAME=gpt-4o-mini
# Embed raw conversation turns so search_turns can work.
ENABLE_TURN_EMBEDDINGS=false

# ---- Processing ownership ----
# Set to durable for hosted thin-writer mode; leave blank for the SDK's in-process default.
MEMORY_PROCESSOR_OWNER=

# ---- MCP transport / server ----
# stdio for local MCP clients; streamable-http for hosted/remote clients.
AGENT_MEMORY_MCP_TRANSPORT=stdio
AGENT_MEMORY_MCP_HOST=127.0.0.1
AGENT_MEMORY_MCP_PORT=8080
AGENT_MEMORY_MCP_HTTP_PATH=/mcp
AGENT_MEMORY_MCP_STATELESS_HTTP=true
AGENT_MEMORY_MCP_LOG_LEVEL=INFO

# ---- Scoping / multi-tenancy ----
# Local fallback user_id when auth is disabled and tools do not pass or bind one.
AGENT_MEMORY_DEFAULT_USER_ID=
# Trusted service-to-service override only: allow user_id args that differ from the token subject.
AGENT_MEMORY_ALLOW_USER_ID_ARG=false

# ---- Tool surface / behavior knobs ----
# Expose advanced granular processing tools in addition to process_thread.
AGENT_MEMORY_EXPOSE_GRANULAR=false
# Server-side cap for top_k/recent_k style result limits.
AGENT_MEMORY_MAX_TOP_K=50

# ---- Provisioning ----
# Local convenience only: create database and containers at startup if missing.
AGENT_MEMORY_AUTO_CREATE=false

# ---- Auth (hosted / Streamable HTTP) ----
# Enable Entra ID JWT validation for remote HTTP mode.
AGENT_MEMORY_AUTH_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
# Optional OAuth resource metadata URL; defaults to the tenant issuer when blank.
AGENT_MEMORY_RESOURCE_SERVER_URL=
# JWT claim used as the memory owner id.
AGENT_MEMORY_USER_ID_CLAIM=oid
# Space- or comma-separated delegated scopes/app roles required on incoming tokens.
AGENT_MEMORY_REQUIRED_SCOPES=
