# AMT REST service - local env template. Copy to `.env` and fill in.
# The app reads these at startup (see app/main.py). It does NOT auto-load this
# file, so export them before running uvicorn (see README / run steps).

# --- Cosmos DB (required) ---
# AAD auth via `az login` is used by default (no key needed).
COSMOS_DB_ENDPOINT="https://<your-cosmos-account>.documents.azure.com:443/"
COSMOS_DB_DATABASE="ai_memory"
# The memories (facts/episodic/procedural) container. Point at an already
# provisioned AMT memory store, or one you create. Example reuses a prefixed set:
COSMOS_DB_MEMORIES_CONTAINER="amt-rest-facts"
COSMOS_DB_TURNS_CONTAINER="amt-rest-turns"
COSMOS_DB_SUMMARIES_CONTAINER="amt-rest-summaries"
COSMOS_DB_COUNTERS_CONTAINER="amt-rest-counter"
COSMOS_DB_LEASE_CONTAINER="amt-rest-lease"
# Optional: use a key instead of AAD (leave unset to use `az login` / managed identity)
# COSMOS_DB_KEY=""

# --- Azure AI Foundry / OpenAI (required for embeddings + chat) ---
AI_FOUNDRY_ENDPOINT="https://<your-foundry>.openai.azure.com/"
AI_FOUNDRY_EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-large"
AI_FOUNDRY_EMBEDDING_DIMENSIONS="1536"
AI_FOUNDRY_CHAT_DEPLOYMENT_NAME="gpt-4o-mini"
# Optional: use a key instead of AAD
# AI_FOUNDRY_API_KEY=""

# --- Auth mode ---
# true (default) uses DefaultAzureCredential (`az login`). Set false only if using keys.
AZURE_USE_DEFAULT_CREDENTIAL="true"

# --- Processing ownership ---
# Leave UNSET (or anything other than "durable") for local testing: the memory
# pipeline (fact extraction, episodes, summaries) runs IN-PROCESS on cadence when
# you POST turns. Set to "durable" only when a sibling Durable Function app owns
# processing (the service then becomes a thin writer).
# MEMORY_PROCESSOR_OWNER="durable"

# --- Optional cadence thresholds (defaults: facts 2, episode 4, thread 10, user 20) ---
# FACT_EXTRACTION_EVERY_N="2"
# EPISODE_EVAL_EVERY_N="4"
# THREAD_SUMMARY_EVERY_N="10"
# USER_SUMMARY_EVERY_N="20"
# DEDUP_EVERY_N="5"

# --- Gateway integration (only when running behind the InferencePlatform Front Door + APIM) ---
# APIM validate-key URL. When set, every functional route requires a valid
# subscription key (headers Ocp-Apim-Subscription-Key + x-requested-account),
# validated against APIM. Leave UNSET for local/direct access (auth is a no-op).
# APIM_VALIDATE_KEY_URL="https://<apim-host>/validateKey"
# Path prefix the app is mounted under behind Front Door (it forwards the full
# path). Set to "/memory" behind the gateway; leave UNSET for local/direct access.
# API_PREFIX="/memory"
